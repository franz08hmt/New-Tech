# Demo PDFs must stay byte-exact: a CRLF rewrite would corrupt their xref offsets.
apps/api/test/fixtures/demo-pdfs/*.pdf binary

# Keep the offline deck and its SHA-256 bindings identical on Windows checkouts.
docs/presentation/deck.* text eol=lf
docs/presentation/assets/*.json text eol=lf
docs/presentation/assets/*.txt text eol=lf
docs/presentation/assets/*.md text eol=lf
docs/submission/ExaMate-Presentation-Visual-*.html text eol=lf
docs/submission/visual-deck-*.json text eol=lf

# Vietnamese technology edition has separate, byte-bound artifacts.
docs/presentation/technology.* text eol=lf
docs/submission/ExaMate-Technologies-VI-*.html text eol=lf
docs/submission/technology-deck-*.json text eol=lf
docs/presentation/assets/logos/*.svg text eol=lf
docs/presentation/assets/logos/*.md text eol=lf
docs/submission/ExaMate-Technologies-Knowledge-VI-*.html text eol=lf
docs/presentation/technology-*.js text eol=lf
docs/presentation/technology-*.css text eol=lf
docs/presentation/technology-*.json text eol=lf
