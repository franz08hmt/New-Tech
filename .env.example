# Copy to .env at repository root; never paste real secrets into chat.
NODE_ENV=development
PORT=3000
# Literal IP only; default loopback independent of PUBLIC_ORIGIN/NODE_ENV.
# Compose overrides HOST=0.0.0.0 internally; API is not published to the host.
HOST=127.0.0.1
# OFF for direct dev/Vite. Optional single closest Nginx IPv4 peer only.
# No booleans, hop counts, subnets or lists. Compose pins its Nginx peer.
TRUSTED_PROXY_IP=
# Copy EXACT direct/session URI from Supabase Connect; URL-encode password.
DATABASE_URL=postgresql://examate_business_runtime:REPLACE_PASSWORD@REPLACE_SESSION_HOST:5432/postgres
# Dedicated non-owner Auth/session runtime login. Must differ from DATABASE_URL.
AUTH_DATABASE_URL=postgresql://examate_auth_runtime:REPLACE_PASSWORD@REPLACE_HOST:5432/postgres
AUTH_DATABASE_POOL_MAX=5
# Maintenance-only; never configure in the API runtime process/container.
MIGRATION_DATABASE_URL=
DATABASE_SSL=true
# Download CA from Supabase; relative paths resolve from repository root.
# Docker: /run/secrets/prod-supabase.cer. Empty = system trust store.
DATABASE_CA_CERT_PATH=secrets/prod-supabase.cer
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT_MS=5000
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
# Prefer SUPABASE_SECRET_KEY=sb_secret_...; legacy service_role JWT is fallback.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_JWT
SUPABASE_STORAGE_BUCKET=study-documents
STORAGE_TIMEOUT_MS=15000
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Dedicated disposable TEST database only; never production.
TEST_DATABASE_URL=
SUPABASE_SECRET_KEY=REPLACE_SUPABASE_SECRET_KEY
# Assistant text-only; backend only. Never put this key in VITE_* variables.
GEMINI_API_KEY=REPLACE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Voice input: local Whisper ONNX; disabled and no weights downloaded by default.
STT_ENABLED=false
STT_PROVIDER=local
STT_MODEL=onnx-community/whisper-small
STT_DEVICE=cpu
STT_DTYPE=q8
STT_MODEL_DIR=artifacts/stt-models
STT_MAX_AUDIO_BYTES=5242880
STT_MAX_DURATION_MS=60000
STT_TIMEOUT_MS=120000
STT_MODEL_LOAD_TIMEOUT_MS=180000
STT_MAX_REQUESTS_PER_MINUTE=5
STT_MAX_CONCURRENT_REQUESTS=1
# ffmpeg/ffprobe must be on PATH, or set absolute executable paths here.
STT_FFMPEG_PATH=ffmpeg
STT_FFPROBE_PATH=ffprobe
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_MS=30000
GEMINI_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=6
RAG_CANDIDATE_LIMIT=10
RAG_MIN_SCORE=0.55
RAG_PROMPT_VERSION=rag-v1
DOCUMENT_OCR_ENABLED=false
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_OCR_TIMEOUT_MS=30000
DOCUMENT_OCR_MAX_PAGES=25

# Controlled pilot Auth: missing configuration fails closed; never use Storage secret here.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Compose sets PUBLIC_ORIGIN and ALLOWED_ORIGINS from this separate origin.
# This does not change API HOST or the origin for direct Vite development.
DOCKER_PUBLIC_ORIGIN=http://127.0.0.1:8080
SUPABASE_PUBLISHABLE_KEY=REPLACE_AUTH_PUBLISHABLE_KEY
PILOT_WORKSPACE_ID=REPLACE_WORKSPACE_UUID
# Server-only canonical base64 of exactly 32 random bytes. Never send in chat/repository.
SESSION_ENCRYPTION_KEY=REPLACE_SESSION_KEY
SESSION_KEY_VERSION=v1
AUTH_VERIFY_CACHE_SECONDS=30
# Default requires USAGE(auth) + SELECT(id,user_id,not_after) ON auth.sessions.
# auth_user alternative requires administrator approval and deployed Auth revocation checks.
AUTH_SESSION_VERIFICATION=database
# DB-backed admission: direct socket by default; validated req.ip ONLY with explicit trusted hop.
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_GLOBAL_LIMIT=100
AUTH_BOOTSTRAP_IP_LIMIT=60
# Auth refresh intent requires at least 2 connections in its independent Auth pool.
# Each API replica may open DATABASE_POOL_MAX + AUTH_DATABASE_POOL_MAX connections.
# Verified conversational question+answer characters, not a token/cost limit (1000..24000).
ASSISTANT_CONTEXT_MAX_CHARS=12000

# F04 persistent admission defaults (per verified user/day; Asia/Ho_Chi_Minh DB day).
# Zero denies that category; omit a setting to use its finite default. Admission cannot be disabled.
AI_ADMISSION_ENABLED=true
AI_ADMISSION_DAILY_OPERATIONS_PER_USER=30
AI_ADMISSION_CONCURRENT_OPERATIONS_PER_USER=2
AI_ADMISSION_CONCURRENT_OPERATIONS_PER_WORKSPACE=5
AI_ADMISSION_MAX_CALLS_GENERAL=1
AI_ADMISSION_MAX_CALLS_DOCUMENTS_QUESTION=2
AI_ADMISSION_MAX_CALLS_SUMMARY=17
# Current maximum: 25 OCR pages + ceil(2000 chunks / 16 chunks per embedding batch) = 150.
AI_ADMISSION_MAX_CALLS_DOCUMENT_INDEX=150
AI_ADMISSION_UNDISPATCHED_LEASE_SECONDS=120

# Google provider must be configured separately in Supabase; false keeps password login.
AUTH_GOOGLE_ENABLED=false
