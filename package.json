{
  "name": "examate-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "npm run build --workspace @examate/api && npm run db:migrate --workspace @examate/api",
    "test:database": "npm run build --workspace @examate/api && npm run test:database --workspace @examate/api",
    "dev:web": "npm run dev --workspace @examate/web",
    "dev:api": "npm run dev --workspace @examate/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  }
}
